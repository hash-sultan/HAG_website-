# Copy to `.env` in the repo root. Leave values empty unless you are running locally.
# Do not commit `.env`.

# Postgres connection string used by the API and Drizzle.
# Local docker-compose default:
# DATABASE_URL=postgres://hag:hag@127.0.0.1:5432/hag
DATABASE_URL=

# Resend (optional locally; quote rows still persist if unset)
RESEND_API_KEY=

# Business inbox that receives new inquiries
CONTACT_TO_EMAIL=

# Verified Resend From address
CONTACT_FROM_EMAIL=

# Used by the process you start. Leave unset for defaults:
# API listens on 5000, Vite on 5173. Start them in separate terminals
# so they do not share one PORT.
PORT=

# Vite public base path. Default: /
BASE_PATH=

# pino log level. Default: info
LOG_LEVEL=
